# 使用 OpenAI 兼容接口的模型配置；真实值只写入本地 .env。
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=replace-with-your-api-key
LLM_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT_SECONDS=30
# Agent 只能访问项目根目录下的这个工作区。
AGENT_WORKSPACE_PATH=sandbox_workspace

# SQLite 状态数据库只能位于项目内 data 目录。
AGENT_STATE_DB_PATH=data/hermes_lite.sqlite3

# 可选：本机回环 Gateway 与 Telegram 私聊渠道。真实令牌只写入 .env。
HERMES_GATEWAY_TOKEN=replace-with-a-long-local-gateway-token
HERMES_GATEWAY_HOST=127.0.0.1
HERMES_GATEWAY_PORT=18791
TELEGRAM_BOT_TOKEN=replace-with-your-telegram-bot-token
TELEGRAM_ALLOWED_USER_ID=0
TELEGRAM_POLL_TIMEOUT_SECONDS=20
